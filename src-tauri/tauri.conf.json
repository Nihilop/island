{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Island",
  "version": "2.4.1",
  "identifier": "com.nihil.island",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "island",
        "width": 760,
        "height": 560,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "island"
        ],
        "name": "Island Extension",
        "description": "Paquet d'extension Island"
      },
      {
        "ext": [
          "islandscene"
        ],
        "name": "Island Scene",
        "description": "Scène de fond animé Island"
      }
    ],
    "resources": [
      "icons/island-file.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Nihilop/island/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDRTA1QzdGMjE3Mjg4MjEKUldRaGlISWhmMXpnYkR5Q2I1cmNBUUlVNWQ1WFpiTC9aQ2FuU05HL0hOU29mcVVoZG0xYit0MCsK"
    }
  }
}
