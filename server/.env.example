# Serveur du magasin Island — copier en `.env` (ignoré par git) et remplir.
# Ne JAMAIS committer le `.env` : il contient des secrets.

# Base Postgres (dev : `docker compose up -d`, port 5433 ; prod : Neon).
DATABASE_URL=postgres://island:island@localhost:5433/island_store

BIND=127.0.0.1:8080
PUBLIC_URL=http://127.0.0.1:8080

# Clé de signature des sessions (32 caractères au moins ; absente = clé éphémère).
SESSION_KEY=

# Super administrateur : identifiant NUMÉRIQUE GitHub (https://api.github.com/users/<login> → "id").
ADMIN_GITHUB_ID=

# Application OAuth GitHub (connexion des modérateurs et du client Island).
# Callback : <PUBLIC_URL>/admin/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stockage : `local:<dossier>` (dev) ou `r2` (Cloudflare R2).
STORAGE=local:./data/files
# `dev` : dossiers `media-dev/` et `packages-dev/` (mêmes compartiments que la production).
STORE_ENV=dev

# Cloudflare R2 (STORAGE=r2). Jeton R2 : « Lecture et écriture d'objets » sur les deux compartiments.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Compartiment PUBLIC des médias, relié à un domaine personnalisé.
R2_BUCKET=island-store
R2_MEDIA_URL=https://cdn.example.com
# Compartiment PRIVÉ des paquets (ni domaine ni URL r2.dev) : liens signés de 5 minutes.
R2_PACKAGES_BUCKET=island-packages

# Clé du magasin (ed25519) : signe les extensions approuvées. Chemin du fichier créé par
# `node packages/sdk/bin/island.mjs keygen <fichier>` (hors dépôt !), ou son contenu, ou le
# PEM PKCS#8. Sans clé, la relecture marche mais l'approbation est impossible.
STORE_SIGNING_KEY=data/store-signing-key.dev.json

# Optionnels
# CLAMAV_URL=127.0.0.1:3310
# TRUST_PROXY=1
# ADMIN_DIST=admin/dist
