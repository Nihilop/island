# Serveur du magasin Island — copier en `.env` (ignoré par git) et remplir.
# Ne JAMAIS committer le `.env` : il contient des secrets.

# Base Postgres (dev : `docker compose up -d`, port 5433 ; prod : Neon).
DATABASE_URL=postgres://island:island@localhost:5433/island_store

BIND=127.0.0.1:8080
PUBLIC_URL=http://127.0.0.1:8080

# Clé de signature des sessions (32 caractères au moins ; absente = clé éphémère).
SESSION_KEY=

# Super administrateur : identifiant NUMÉRIQUE GitHub (https://api.github.com/users/<login> → "id").
ADMIN_GITHUB_ID=

# Application OAuth GitHub (connexion des modérateurs et du client Island).
# Callback : <PUBLIC_URL>/admin/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stockage : `local:<dossier>` (dev) ou `r2` (Cloudflare R2).
STORAGE=local:./data/files
# `dev` : dossiers `media-dev/` et `packages-dev/` dans le compartiment.
STORE_ENV=dev

# Cloudflare R2 (STORAGE=r2). Jeton R2 : « Lecture et écriture d'objets », limité au compartiment.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=island-store
# Domaine public du compartiment (médias seulement ; `/packages*` bloqué par une règle WAF).
R2_MEDIA_URL=https://cdn.example.com

# Optionnels
# CLAMAV_URL=tcp://127.0.0.1:3310
# TRUST_PROXY=1
# ADMIN_DIST=admin/dist
