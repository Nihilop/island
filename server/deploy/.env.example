# Island store — production settings. Copy to `.env` next to docker-compose.yml.
# Never commit `.env` or the `secrets/` folder: they hold secrets.

# --- Stack ------------------------------------------------------------------------------
# Image: ghcr.io/<GHCR_OWNER>/island-store (lowercase owner, e.g. the GitHub user or org).
GHCR_OWNER=
STORE_TAG=latest
# Optional services: tunnel, antivirus, local-db (comma-separated, or empty).
COMPOSE_PROFILES=tunnel
# Host port bound on 127.0.0.1 (for a reverse proxy on the same machine).
STORE_PORT=8080

# --- Public address -----------------------------------------------------------------------
# HTTPS address users reach (cookies become Secure). Island apps must be BUILT with this
# URL (ISLAND_STORE_URL, see the root .env.example of the app).
PUBLIC_URL=https://store.example.com
# Behind the tunnel or a reverse proxy: read the client IP from X-Forwarded-For.
TRUST_PROXY=1

# --- Database -----------------------------------------------------------------------------
# Hosted Postgres (e.g. Neon, DIRECT connection, not the pooler):
DATABASE_URL=postgres://user:password@host/island_store?sslmode=require
# With COMPOSE_PROFILES=local-db instead:
#   POSTGRES_PASSWORD=<a long random password>
#   DATABASE_URL=postgres://island:<same password>@postgres:5432/island_store

# --- Secrets ------------------------------------------------------------------------------
# openssl rand -base64 48
SESSION_KEY=
# The store key itself is the file secrets/store-signing-key.json (see docker-compose.yml).

# --- GitHub sign-in (OAuth App with Device Flow enabled) ------------------------------------
# Callback URL: <PUBLIC_URL>/admin/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub id of the super admin: curl -s https://api.github.com/users/<login>
ADMIN_GITHUB_ID=

# --- Cloudflare R2 ------------------------------------------------------------------------
STORAGE=r2
R2_ACCOUNT_ID=
# API token with Object Read & Write on BOTH buckets.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# PUBLIC bucket (media), connected to a custom domain:
R2_BUCKET=island-store
R2_MEDIA_URL=https://cdn.example.com
# PRIVATE bucket (packages): no custom domain, r2.dev disabled.
R2_PACKAGES_BUCKET=island-packages

# --- Optional -----------------------------------------------------------------------------
# With COMPOSE_PROFILES=antivirus:
# CLAMAV_URL=clamav:3310
# With COMPOSE_PROFILES=tunnel: the tunnel token (Cloudflare Zero Trust › Tunnels).
TUNNEL_TOKEN=
